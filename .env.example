# Orugas environment. Copy to .env and run `npm run ports` to fill the ports.
# .env is gitignored. Ports only in .env; the API keys below are read from the
# process environment or from this file by the tools, never committed.

# Vite dev and preview port (strictPort). Never 5173, it belongs to another local project.
VITE_PORT=5174

# Standalone CPU sidecar port, bound to 127.0.0.1 only. Never 8787, it belongs to another local project.
SIDECAR_PORT=8788

# Asset pipeline (tools/assets, Phase 1F). Leave empty here; export it in the shell or put it in .env.
REPLICATE_API_TOKEN=

# Sound pipeline (tools/audio, Phase 1G). Leave empty here; export it in the shell or put it in .env.
ELEVENLABS_API_KEY=

# The Anthropic key for the CPU sidecar lives in sidecar/.env (see sidecar/.env.example), not here.
