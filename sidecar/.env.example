# CPU sidecar environment. Copy to sidecar/.env (gitignored). Never commit the real file.

# Backend for CPU turns: api (Anthropic Messages API with Haiku, recommended), cli (claude -p with the
# isolation set), off (heuristic only). Phase 1E wires api and cli; until then the sidecar answers off.
ORUGAS_CPU_BACKEND=off

# Kill switch: off makes every CPU turn fall back to the deterministic heuristic without calling any model.
ORUGAS_CPU_LLM=on

# Anthropic API key, only for ORUGAS_CPU_BACKEND=api. Read from the environment or from this file at startup.
ANTHROPIC_API_KEY=

# Per match call budget, set after the Phase 0.3 latency and cost smoke.
ORUGAS_CPU_MAX_CALLS_PER_MATCH=200

# Voice agent (src/voice, GET /api/voice/session). Create it with `npm run voice:agent`, then set its id here.
# With the key the agent stays private and the server mints signed URLs; without it the agent must be public.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
