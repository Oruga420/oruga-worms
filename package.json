{
    "name":  "orugas",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Orugas, a Worms style turn based artillery game in the browser (TypeScript, Vite, Canvas 2D)",
    "license":  "UNLICENSED",
    "engines":  {
                    "node":  "\u003e=24.0.0"
                },
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit -p tsconfig.json \u0026\u0026 tsc --noEmit -p tsconfig.sidecar.json",
                    "lint":  "eslint .",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "e2e":  "playwright test",
                    "sidecar":  "node sidecar/index.ts",
                    "ports":  "node scripts/find-ports.mjs",
                    "audio:generate":  "node tools/audio/generate.ts"
                },
    "devDependencies":  {
                            "@eslint/js":  "10.0.1",
                            "@playwright/test":  "1.62.1",
                            "@types/node":  "24.13.3",
                            "@vitest/coverage-v8":  "5.0.0",
                            "eslint":  "10.9.1",
                            "globals":  "17.12.0",
                            "typescript":  "5.9.3",
                            "typescript-eslint":  "8.69.0",
                            "vite":  "8.2.2",
                            "vitest":  "5.0.0"
                        },
    "dependencies":  {
                         "@anthropic-ai/sdk":  "0.123.0",
                         "zod":  "4.5.4"
                     }
}
